# ============================================================
#  ~/.zshrc
#
#  Es tu configuración de CachyOS, traducida para que funcione
#  igual en Arch y en Debian. Viene de /usr/share/cachyos-zsh-config
#  más lo que tenías añadido a mano.
#
#  Lo tuyo va en ~/.zshrc.local — ese archivo no lo pisa nadie.
# ============================================================

typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet

# ------------------------------------------------------------
#  Saludo del terminal.
#  Va ANTES del instant prompt de p10k a propósito: ese preámbulo
#  captura la salida en un buffer para poder redibujar el prompt, y
#  fastfetch se niega a pintar imágenes cuando su salida no es un
#  terminal directo ("Image logo is not supported in pipe mode").
#  Puesto aquí arriba, escribe directo al terminal y sí saca la imagen.
# ------------------------------------------------------------
# Ruta explícita a propósito: aquí arriba ~/.local/bin todavía NO está en
# el PATH (se añade más abajo), así que command -v no lo encontraría.
[[ -o interactive ]] && for _rf in "$HOME/.local/bin/rice-fetch" /usr/local/bin/rice-fetch; do
  [[ -x "$_rf" ]] && { "$_rf"; break }
done; unset _rf

# --- Instant prompt de p10k. Va PRIMERO, siempre. Todo lo que pida
#     algo por teclado (contraseñas, [y/n]) tiene que ir ARRIBA de esto.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ------------------------------------------------------------
#  Qué distro es esta
# ------------------------------------------------------------
RICE_DISTRO=desconocida
if [[ -r /etc/os-release ]]; then
  local _id _like
  _id=$(awk -F= '/^ID=/{gsub(/"/,"",$2);print $2}' /etc/os-release)
  _like=$(awk -F= '/^ID_LIKE=/{gsub(/"/,"",$2);print $2}' /etc/os-release)
  case " $_id $_like " in
    *arch*|*cachyos*)   RICE_DISTRO=arch ;;
    *debian*|*ubuntu*)  RICE_DISTRO=debian ;;
    *fedora*|*rhel*)    RICE_DISTRO=fedora ;;
  esac
fi
export RICE_DISTRO

_rice() { [[ -r "$1" ]] && source "$1" && return 0 || return 1 }
_ZL="${XDG_DATA_HOME:-$HOME/.local/share}/zsh"

# ------------------------------------------------------------
#  oh-my-zsh  (mismos plugins que traía CachyOS)
# ------------------------------------------------------------
if   [[ -d /usr/share/oh-my-zsh ]];  then export ZSH=/usr/share/oh-my-zsh
elif [[ -d "$_ZL/oh-my-zsh" ]];      then export ZSH="$_ZL/oh-my-zsh"
elif [[ -d "$HOME/.oh-my-zsh" ]];    then export ZSH="$HOME/.oh-my-zsh"
fi

DISABLE_MAGIC_FUNCTIONS="true"     # pegar URLs sin que se rompa
ENABLE_CORRECTION="true"           # corrige comandos mal escritos
COMPLETION_WAITING_DOTS="true"     # puntitos mientras piensa
DISABLE_AUTO_UPDATE="true"

[[ -z "${plugins[*]}" ]] && plugins=(git fzf extract)
[[ -n "${ZSH:-}" && -r "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# ------------------------------------------------------------
#  Historial
# ------------------------------------------------------------
HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
HISTSIZE=50000
SAVEHIST=50000
export HISTCONTROL=ignoreboth
export HISTORY_IGNORE="(\&|[bf]g|c|clear|history|exit|q|pwd|* --help)"
setopt EXTENDED_HISTORY INC_APPEND_HISTORY SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS HIST_VERIFY
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS INTERACTIVE_COMMENTS NO_BEEP

# ------------------------------------------------------------
#  Páginas de manual con color (venía en la config de CachyOS)
# ------------------------------------------------------------
export LESS_TERMCAP_md="$(tput bold 2> /dev/null; tput setaf 2 2> /dev/null)"
export LESS_TERMCAP_me="$(tput sgr0 2> /dev/null)"

# ------------------------------------------------------------
#  Alias: los comunes + los que dependen del gestor de paquetes
# ------------------------------------------------------------
_RICE_ZSH="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"
_rice "$_RICE_ZSH/aliases-comunes.zsh"
_rice "$_RICE_ZSH/aliases-herramientas.zsh"
case "$RICE_DISTRO" in
  arch)   _rice "$_RICE_ZSH/aliases-arch.zsh" ;;
  debian) _rice "$_RICE_ZSH/aliases-debian.zsh" ;;
esac

# ------------------------------------------------------------
#  Prompt: Powerlevel10k
# ------------------------------------------------------------
_rice /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme \
  || _rice /usr/share/powerlevel10k/powerlevel10k.zsh-theme \
  || _rice "$_ZL/powerlevel10k/powerlevel10k.zsh-theme"

# ------------------------------------------------------------
#  Autocompletado inteligente (fzf-tab + zstyle).
#  Va ANTES de las sugerencias y el resaltado: esos dos envuelven
#  widgets y fzf-tab tiene que envolverlos primero.
# ------------------------------------------------------------
_rice "$_RICE_ZSH/completado.zsh"

# ------------------------------------------------------------
#  Sugerencias, resaltado y búsqueda en el historial.
#  El resaltado SIEMPRE al final: es requisito del plugin.
# ------------------------------------------------------------
_rice /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh \
  || _rice /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  || _rice "$_ZL/zsh-autosuggestions/zsh-autosuggestions.zsh"
_rice "$_RICE_ZSH/sugerencias.zsh"

_rice /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh \
  || _rice /usr/share/zsh-history-substring-search/zsh-history-substring-search.zsh \
  || _rice "$_ZL/zsh-history-substring-search/zsh-history-substring-search.zsh"

_rice /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  || _rice /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  || _rice "$_ZL/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# ------------------------------------------------------------
#  "comando no encontrado" -> te dice qué paquete instalar
# ------------------------------------------------------------
_rice /usr/share/doc/pkgfile/command-not-found.zsh \
  || _rice /etc/zsh_command_not_found

# ------------------------------------------------------------
#  Teclas
# ------------------------------------------------------------
bindkey -e
bindkey '^[[A' history-substring-search-up   2>/dev/null
bindkey '^[[B' history-substring-search-down 2>/dev/null
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[[3~' delete-char
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line

# ------------------------------------------------------------
#  fzf
# ------------------------------------------------------------
[[ -d /usr/share/fzf ]] && export FZF_BASE=/usr/share/fzf
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh) 2>/dev/null \
    || { _rice /usr/share/doc/fzf/examples/key-bindings.zsh
         _rice /usr/share/doc/fzf/examples/completion.zsh }
  export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border=rounded \
--color=bg+:#292e42,bg:#1a1b26,spinner:#bb9af7,hl:#7aa2f7 \
--color=fg:#c0caf5,header:#7aa2f7,info:#e0af68,pointer:#bb9af7 \
--color=marker:#9ece6a,fg+:#c0caf5,prompt:#7aa2f7,hl+:#7aa2f7"
  # fzf ata Tab a su propio completado y pisa a fzf-tab, que se cargó antes.
  # Los atajos de fzf (Ctrl+T, Ctrl+R, Alt+C) sí los queremos; el Tab no.
  if (( $+functions[fzf-tab-complete] )); then
    bindkey '^I' fzf-tab-complete
  fi
fi

# ------------------------------------------------------------
#  PATH  (lo que tenías, más lo que aparezca)
# ------------------------------------------------------------
typeset -U path
path=("$HOME/.local/bin" $path)
[[ -d "$HOME/flutter/bin" ]]                 && path=("$HOME/flutter/bin" $path)
[[ -d "$HOME/.cargo/bin" ]]                  && path=("$HOME/.cargo/bin" $path)
[[ -d "$HOME/Android/Sdk/platform-tools" ]]  && path=("$HOME/Android/Sdk/platform-tools" $path)
export PATH

export EDITOR="${EDITOR:-micro}"
export VISUAL="$EDITOR"

# zoxide: 'z carpeta' salta a donde ya estuviste
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# ------------------------------------------------------------
#  Saludo al abrir el terminal. Si cansa, comenta estas líneas.
# ------------------------------------------------------------

# ------------------------------------------------------------
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
_rice "$HOME/.zshrc.local"
