#!/usr/bin/env bash
# Arranca los demonios del escritorio. Lo llama Hyprland con un solo exec-once.
# Lanza únicamente lo que esté instalado: si falta algo, sigue sin romperse.
set -uo pipefail
# RICE_PATH_FIX: Hyprland lanza con /bin/sh, que no lee ningún perfil.
# Sin esto, un script no encontraría a los otros al arrancar la sesión.
PATH="$HOME/.local/bin:$PATH"; export PATH


have()    { command -v "$1" >/dev/null 2>&1; }
running() { pgrep -x "$1" >/dev/null 2>&1; }
run()     { have "$1" || return 0; running "$1" && return 0; setsid "$@" >/dev/null 2>&1 & }

# --- 1. entorno para portales, systemd y apps de bandeja ---
have dbus-update-activation-environment && dbus-update-activation-environment --systemd --all
systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP HYPRLAND_INSTANCE_SIGNATURE 2>/dev/null

# --- 2. agente de polkit (para que las apps puedan pedir contraseña) ---
if have hyprpolkitagent; then
  systemctl --user start hyprpolkitagent 2>/dev/null || run hyprpolkitagent
else
  for p in /usr/lib/polkit-kde-authentication-agent-1 \
           /usr/libexec/polkit-kde-authentication-agent-1 \
           /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
           /usr/libexec/polkit-gnome-authentication-agent-1; do
    [ -x "$p" ] && { setsid "$p" >/dev/null 2>&1 & break; }
  done
  have lxpolkit && run lxpolkit
fi

# --- 3. notificaciones / centro de control ---
if   have swaync;                  then run swaync
elif have sway-notification-center; then run sway-notification-center
elif have mako;                    then run mako
elif have dunst;                   then run dunst
fi

# --- 4. portapapeles: cliphist escucha todo lo que copies ---
if have cliphist && have wl-paste; then
  pgrep -f "wl-paste --type text" >/dev/null || setsid wl-paste --type text  --watch cliphist store >/dev/null 2>&1 &
  pgrep -f "wl-paste --type image" >/dev/null || setsid wl-paste --type image --watch cliphist store >/dev/null 2>&1 &
fi

# --- 5. fondo de pantalla ---
if have swww; then
  running swww-daemon || { setsid swww-daemon >/dev/null 2>&1 & sleep 1; }
  rice-wallpaper restore
elif have hyprpaper; then
  run hyprpaper
  sleep 1; rice-wallpaper restore
fi

# --- 6. OSD de volumen/brillo, idle, barra ---
# swayosd: el binario se llama distinto según el empaquetado
for o in swayosd-server swayosd; do
  have "$o" && { running "$o" || { setsid "$o" >/dev/null 2>&1 & }; break; }
done
run hypridle
run waybar

# --- 7. opcionales de bandeja ---
run nm-applet --indicator
run blueman-applet

exit 0
