// ============================================================
//  Disposición OFICIAL de HyDE (su layout hyprdots/04)
//
//  Lo distintivo de HyDE, y lo que lo hace verse distinto:
//    · CPU/RAM y el RELOJ van a la IZQUIERDA
//    · Los WORKSPACES van al CENTRO
//    · Todo lo demás a la derecha, en tres islas
//
//  Cada isla es un "group/pill#nombre". Para mover un módulo,
//  córtalo de una lista "modules" y pégalo en otra.
//
//  Casi todo abre un PANEL de Noctalia al hacer clic
//  (volumen -> salidas de audio, CPU -> monitor del sistema...).
//  Lista completa de comandos:  noctalia msg --help
// ============================================================
{
  "layer": "top",
  "position": "top",
  "output": ["*"],
  "height": 42,
  "exclusive": true,
  "passthrough": false,
  "reload_style_on_change": true,

  "include": [
    "/home/charly/.config/waybar/modules/cpu.jsonc",
    "/home/charly/.config/waybar/modules/memory.jsonc",
    "/home/charly/.config/waybar/modules/temperature.jsonc",
    "/home/charly/.config/waybar/modules/clock.jsonc",
    "/home/charly/.config/waybar/modules/network.jsonc",
    "/home/charly/.config/waybar/modules/pulseaudio.jsonc",
    "/home/charly/.config/waybar/modules/pulseaudio_microphone.jsonc",
    "/home/charly/.config/waybar/modules/battery.jsonc",
    "/home/charly/.config/waybar/modules/tray.jsonc",
    "/home/charly/.config/waybar/modules/idle_inhibitor.jsonc",
    "/home/charly/.config/waybar/modules/hyprland-workspaces.jsonc"
  ],

  // ============ IZQUIERDA: sistema + reloj ============
  "modules-left": [
    "group/pill#left1",
    "group/pill#left2"
  ],

  "group/pill#left1": {
    "orientation": "inherit",
    "modules": ["custom/logo", "cpu", "memory", "temperature"]
  },

  "group/pill#left2": {
    "orientation": "inherit",
    "modules": ["idle_inhibitor", "clock"]
  },

  // ============ CENTRO: workspaces + qué suena ============
  "modules-center": [
    "group/pill#center"
  ],

  "group/pill#center": {
    "orientation": "inherit",
    "modules": ["hyprland/workspaces", "mpris"]
  },

  // ============ DERECHA: hardware, bandeja, herramientas ============
  "modules-right": [
    "group/pill#right1",
    "group/pill#right2",
    "group/pill#right3"
  ],

  "group/pill#right1": {
    "orientation": "inherit",
    "modules": [
      "backlight",
      "pulseaudio",
      "pulseaudio#microphone",
      "network",
      "custom/updates"
    ]
  },

  "group/pill#right2": {
    "orientation": "inherit",
    "modules": ["tray", "battery"]
  },

  "group/pill#right3": {
    "orientation": "inherit",
    "modules": [
      "custom/wallpaper",
      "custom/theme",
      "custom/clipboard",
      "custom/screenshot",
      "custom/settings",
      "custom/power"
    ]
  },

  // ==================== DEFINICIONES PROPIAS ====================
  // HyDE resuelve estas con su binario 'hyde-shell'.
  // Aquí van contra la API de Noctalia, que sí tienes.

  "custom/logo": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "Lanzador de aplicaciones",
    "on-click": "noctalia msg panel-toggle launcher",
    "on-click-right": "noctalia msg panel-toggle control-center"
  },

  // El módulo de medios: muestra qué suena y despliega el panel
  "mpris": {
    "format": "󰎇  {title}",
    "format-paused": "󰏤  {title}",
    "format-stopped": "󰎇  —",
    // Súbelo y otros módulos empezarán a mostrar "…" por falta de espacio
    "max-length": 24,
    "tooltip-format": "{player}: {title}\n{artist}",
    "on-click": "noctalia msg panel-toggle control-center media",
    "on-click-middle": "noctalia msg media toggle",
    "on-scroll-up": "noctalia msg media next",
    "on-scroll-down": "noctalia msg media previous"
  },

  "backlight": {
    "device": "nvidia_0",
    "format": "󰃟 {percent}%",
    "tooltip-format": "Brillo: {percent}%\nClic para el panel de pantalla",
    "on-click": "noctalia msg panel-toggle control-center brightness",
    "on-scroll-up": "noctalia msg brightness-up",
    "on-scroll-down": "noctalia msg brightness-down"
  },

  "custom/updates": {
    "format": "󰇚 {}",
    "exec": "checkupdates 2>/dev/null | wc -l",
    "interval": 1800,
    "tooltip": true,
    "tooltip-format": "Actualizaciones pendientes de pacman",
    "on-click": "alacritty -e sh -c 'checkupdates; read -p \"Enter para cerrar\"'"
  },

  // ---------- HERRAMIENTAS ----------

  "custom/wallpaper": {
    "format": "󰸉",
    "tooltip": true,
    "tooltip-format": "Selector de fondos\nClic derecho: siguiente · Rueda: cambiar",
    "on-click": "noctalia msg panel-toggle wallpaper",
    "on-click-right": "noctalia msg wallpaper-next",
    "on-scroll-up": "noctalia msg wallpaper-next",
    "on-scroll-down": "noctalia msg wallpaper-previous"
  },

  "custom/theme": {
    "format": "󰏘",
    "tooltip": true,
    "tooltip-format": "Tema claro/oscuro\nClic derecho: elegir paleta",
    "on-click": "noctalia msg theme-mode-toggle",
    "on-click-right": "noctalia msg settings-open"
  },

  "custom/clipboard": {
    "format": "󰅌",
    "tooltip": true,
    "tooltip-format": "Portapapeles (igual que Super+V)",
    "on-click": "noctalia msg panel-toggle clipboard"
  },

  "custom/screenshot": {
    "format": "󰹑",
    "tooltip": true,
    "tooltip-format": "Captura de región (igual que Print)\nClic derecho: pantalla completa",
    "on-click": "noctalia msg screenshot-region",
    "on-click-right": "noctalia msg screenshot-fullscreen"
  },

  "custom/settings": {
    "format": "󰒓",
    "tooltip": true,
    "tooltip-format": "Centro de control\nClic derecho: ajustes de Noctalia",
    "on-click": "noctalia msg panel-toggle control-center",
    "on-click-right": "noctalia msg settings-toggle"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": true,
    "tooltip-format": "Menú de sesión\nClic derecho: bloquear",
    "on-click": "noctalia msg panel-toggle session",
    "on-click-right": "noctalia msg session lock"
  }
}
