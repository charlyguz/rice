{
  "pulseaudio": {
    "format": "{icon} {volume}",
    "rotate": 0,
    "format-muted": "婢",
    "on-click": "noctalia msg panel-toggle control-center audio",
    "on-click-right": "noctalia msg panel-toggle control-center audio",
    "on-click-middle": "noctalia msg volume-mute",
    "on-scroll-up": "noctalia msg volume-up",
    "on-scroll-down": "noctalia msg volume-down",
    "tooltip-format": "{icon} {desc} // {volume}%",
    "scroll-step": 5,
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    }
  }
}
